# Get your token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Admin: secret command (e.g. /admin_secret) and password. If not set, admin mode is disabled.
# ADMIN_COMMAND=/admin_secret
# ADMIN_PASSWORD=your_admin_password

# Max places per (department, time slot). Default: 25
# SLOT_CAPACITY=25

# Optional: sync registrations to Google Sheets (each new/updated subscription appends a row)
# GOOGLE_SHEETS_ID=your_spreadsheet_id_from_url
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./path/to/service-account-key.json
# Or paste the key JSON as a single line:
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}
